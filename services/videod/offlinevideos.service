[Unit]
Description=OfflineVideos downloader service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=offlinevideos
Group=offlinevideos
WorkingDirectory=/opt/offlinevideos
EnvironmentFile=/etc/offlinevideos/offlinevideos.env
ExecStart=/opt/offlinevideos/videod
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
