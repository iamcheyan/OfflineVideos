# Example only. Copy to a private EnvironmentFile and replace each value.
OFFLINEVIDEOS_DATA_DIR=/path/to/private/offlinevideos-data
OFFLINEVIDEOS_DOWNLOAD_DIR=/path/to/mounted/media/offline_video
OFFLINEVIDEOS_LISTEN=127.0.0.1:8732
OFFLINEVIDEOS_SYNC_INTERVAL_MIN=60
OFFLINEVIDEOS_CONCURRENCY=2
OFFLINEVIDEOS_AUTO_DOWNLOAD=on
# Optional executable overrides:
# OFFLINEVIDEOS_YTDLP=/path/to/yt-dlp
# OFFLINEVIDEOS_MPV=/path/to/mpv
